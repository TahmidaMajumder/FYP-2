        return x * 50 / 54.0
    elif x <= 154.0:
        return 50 + (x - 54.0) * (100 - 50) / (154.0 - 54.0)
    elif x <= 254.0:
        return 100 + (x - 154.0) * (150 - 100) / (254.0 - 154.0)
    elif x <= 354.0:
        return 150 + (x - 254.0) * (200 - 150) / (354.0 - 254.0)
    elif x <= 424.0:
